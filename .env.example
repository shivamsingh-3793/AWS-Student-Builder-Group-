# GEMINI_API_KEY: Optional AI Studio environment key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_URL: Optional API base URL (defaults to same-origin when served via server.ts)
VITE_API_URL=""

# NEXT_PUBLIC_API_URL: Supported alias for external API deployments
NEXT_PUBLIC_API_URL=""
