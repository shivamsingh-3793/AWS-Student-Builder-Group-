# GEMINI_API_KEY: Optional AI Studio environment key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Public API origin; VITE_API_URL takes precedence over NEXT_PUBLIC_API_URL.
# Leave empty only when the frontend and API are served from the same origin.
VITE_API_URL=""

# Public alias supported for external API deployments.
NEXT_PUBLIC_API_URL=""
